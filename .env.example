PORT=3000

# Obligatoria. Supabase → botón "Connect" → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos, sin corchetes.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Ruta al certificado CA de Supabase (Database → Settings → SSL Configuration).
SUPABASE_DB_CA_CERT=./supabase-ca.crt
