PORT=3000

# Obligatoria. Supabase → botón "Connect" → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos, sin corchetes.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Ruta al certificado CA de Supabase (Database → Settings → SSL Configuration).
SUPABASE_DB_CA_CERT=./supabase-ca.crt

# Inicio de sesión. Supabase → Project Settings → Data API → Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave PÚBLICA (se envía al navegador). Supabase → Project Settings → API Keys → Publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave SECRETA (solo servidor; permite crear usuarios). Supabase → Project Settings → API Keys → Secret keys.
# Nunca la compartas ni la uses en el frontend.
SUPABASE_SECRET_KEY=sb_secret_...
